// KriptoBeyan — veri modeli.
// Hassas alanlar (twoFactorSecret, ExchangeConnection.encrypted*) uygulama
// katmanında AES-256-GCM ile şifrelenmiş halde saklanır (bkz. src/crypto).
//
// NOT: TaxYearSummary/TaxLot çıktısı her zaman "taslak/tahmini" niteliğinde —
// bu modülün hesaplama mantığı bir mali müşavirle doğrulanana kadar kesin
// rakam gibi sunulmamalı (bkz. TaxCalculationService).

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTH + USER
// ============================================================

// Kullanıcı tipi — BIREYSEL yatırımcı mı, müşterileri adına giriş yapan bir
// MUHASEBECI mi (bkz. AccountantClient, AccountantDashboard modülü). Ayrıca
// Plan.type için de kullanılıyor (hangi plan hangi rol için satılıyor).
enum UserRole {
  INDIVIDUAL
  ACCOUNTANT
}

enum TaxpayerType {
  INDIVIDUAL // gerçek kişi — değer artış kazancı
  BUSINESS   // ticari işletme — ticari kazanç
}

enum CostBasisMethod {
  FIFO
  // İleride: LIFO, AVERAGE_COST — şimdilik sadece FIFO uygulanıyor
  // (bkz. TaxCalculationService), alan esnek bırakıldı.
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Giriş icin ikinci kimlik (kullanici adi) — ORCA'daki username/email/
  // telefon uc yontemli giris deseninden alindi. Email HER ZAMAN zorunlu
  // kalir (dogrulama/sifre sifirlama/2FA hep email'e bagli — bkz. auth
  // servisi) — username ve telefon sadece EK giris yollari, email'in
  // yerine gecmez.
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Kişisel bilgiler
  fullName        String?
  phone           String?  @unique
  phoneCountryCode String?
  role            UserRole @default(INDIVIDUAL)

  // E-posta doğrulama
  emailVerified            Boolean   @default(false)
  emailVerificationHash    String?
  emailVerificationExpires DateTime?

  // Telefon dogrulama — kayit sirasinda 6 haneli kod uretilip SmsService ile
  // gonderiliyor (SMS_PROVIDER_API_KEY bos oldugu surece sadece loglanir,
  // bkz. sms.service.ts). Giris bu alana bakmiyor (email dogrulamayla ayni
  // yumusak davranis) — admin panelden de elle isaretlenebilir.
  phoneVerified             Boolean   @default(false)
  phoneVerificationCodeHash String?
  phoneVerificationExpires  DateTime?

  // Şifre sıfırlama
  passwordResetHash    String?
  passwordResetExpires DateTime?

  // Brute-force kilidi — art arda başarısız girişten sonra hesap geçici kilitlenir.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // 2FA (TOTP) — secret AES-256-GCM ile şifreli saklanır, düz metin DEĞİL.
  twoFactorEnabled         Boolean @default(false)
  twoFactorSecretEncrypted String?

  // Vergi ayarları
  baseCurrency    String          @default("TRY")
  costBasisMethod CostBasisMethod @default(FIFO)
  taxpayerType    TaxpayerType    @default(INDIVIDUAL)
  timezone        String          @default("Europe/Istanbul")
  // Şimdilik sabit "Türkiye" ama ayrı alan — çoklu ülke desteğine hazır.
  jurisdiction    String          @default("Türkiye")
  // Dashboard'da o an görüntülenen vergi yılı; geçmiş yıllar TaxYearSummary'de arşivli.
  activeTaxYear   Int             @default(dbgenerated("EXTRACT(YEAR FROM CURRENT_DATE)::int"))

  // Abonelik durumu (aktif plan/bitiş tarihi/limit) Subscription+Plan
  // ilişkisinden TÜRETİLİR — burada ham alan tutulmuyor (bkz. SubscriptionService).

  // Bildirim tercihleri
  declarationReminderEnabled Boolean @default(true)

  // Mali musavir kimlik dogrulama — kayit HER ZAMAN acik (rol=ACCOUNTANT
  // secip kayit olmak serbest), ama musteri davet edebilmek icin (bkz.
  // AccountantService.inviteClient) her iki belge de yuklenmis VE admin
  // tarafindan onaylanmis olmali. Belgeler storage/accountant-verification/
  // altinda saklanir, sadece sahibi ve admin gorebilir.
  accountantLicenseDocUrl   String?
  accountantTaxPlateDocUrl  String?
  accountantVerified        Boolean   @default(false)
  accountantVerifiedAt      DateTime?

  // Admin panelindeki "aktif kullanıcılar" listesi icin — JwtAuthGuard her
  // basarili istekte gunceller (bkz. LastSeenInterceptor), gercek zamanli
  // WebSocket presence yerine bilerek basit "son N dakikada istek atti mi"
  // yaklasimi kullanildi (ORCA'daki gibi ayri bir socket.io altyapisi yok).
  lastSeenAt DateTime?

  refreshTokens        RefreshToken[]
  exchangeConnections  ExchangeConnection[]
  walletAddresses      WalletAddress[]
  csvImports           CsvImport[]
  transactions         Transaction[]
  reconciliationFlags  ReconciliationFlag[]
  taxLots              TaxLot[]
  taxYearSummaries     TaxYearSummary[]
  generatedReports     GeneratedReport[]
  notifications        NotificationLog[]
  subscriptions        Subscription[]
  payments             Payment[]
  auditLogs            AuditLog[]
  securityLogs         SecurityLog[]

  // Muhasebeci ise: davet ettiği müşteriler. Bireysel kullanıcıysa: kendisini
  // müşteri olarak ekleyen muhasebeci ilişkisi (genelde en fazla 1 kayıt).
  accountantOfClients AccountantClient[] @relation("AccountantOf")
  clientOfAccountant  AccountantClient[] @relation("ClientOf")

  staffRecord Staff?

  supportTickets      SupportTicket[]
  sentSupportMessages SupportMessage[]

  couponCodes       CouponCode[]
  couponRedemptions CouponRedemption[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Ham refresh token ASLA saklanmaz — sadece SHA-256 hash'i. Token
  // kullanıcıya bir kere gösterilir, DB'de kırılsa bile işe yaramaz.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum AccountantClientStatus {
  PENDING // davet gönderildi, müşteri henüz kabul etmedi
  ACTIVE  // müşteri hesabını oluşturup daveti kabul etti
  REMOVED // muhasebeci tarafından çıkarıldı / slot boşaltıldı
}

// Bir muhasebecinin hangi bireysel kullanıcılara (müşterilerine) erişimi
// olduğunu tutar. Muhasebeci ASLA müşterinin borsa API key'lerini görmez/
// girmez — sadece bu ilişki üzerinden hesaplanmış rapor/özet verisine
// (TaxYearSummary, ReconciliationFlag vb.) salt-okunur erişir (bkz.
// AccountantService — her erişimde bu tablo üzerinden yetki kontrolü yapılır).
model AccountantClient {
  id               String                 @id @default(uuid())
  accountantUserId String
  accountant       User                   @relation("AccountantOf", fields: [accountantUserId], references: [id], onDelete: Cascade)
  // Davet kabul edilene kadar null — kullanıcı henüz kayıt olmamış olabilir.
  clientUserId     String?
  client           User?                  @relation("ClientOf", fields: [clientUserId], references: [id], onDelete: Cascade)
  inviteEmail      String
  inviteTokenHash  String?
  inviteExpiresAt  DateTime?
  status           AccountantClientStatus @default(PENDING)
  invitedAt        DateTime               @default(now())
  acceptedAt       DateTime?
  removedAt        DateTime?

  @@index([accountantUserId])
  @@index([clientUserId])
  @@map("accountant_clients")
}

enum StaffRole {
  ADMIN // simdilik tek rol — plan fiyat/limit duzenleme + odeme onaylama
}

// Gercek admin/staff modeli — .env'deki ADMIN_EMAILS bootstrap'inin yerini
// alir. Staff olmak icin once normal bir User hesabi (email/parola/2FA vb.
// AYNI guvenlik altyapisi) gerekir, sonra buraya bir kayit eklenir. Birden
// fazla kisi odeme onaylayabilsin diye DB tablosu — redeploy gerekmeden
// ekle/cikar (bkz. AdminGuard, scripts/promote-staff.ts).
model Staff {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      StaffRole @default(ADMIN)
  addedAt   DateTime  @default(now())
  addedById String? // hangi staff ekledi (ilk kayıt için null — bkz. promote-staff script)

  @@map("staff")
}

// ============================================================
// EXCHANGE INTEGRATION
// ============================================================

// Turkiye top8 (API sunan) + global tier-1 top10 (API sunan), cakisanlar
// (BINANCE/BYBIT/OKX) tek sefer sayilir. GERCEK/STUB durumu icin ilgili
// adapter dosyasindaki yorumlara bakin (adapters/*.adapter.ts).
enum ExchangeProvider {
  // --- Turkiye ---
  BINANCE
  BTCTURK
  PARIBU
  BITEXEN
  ICRYPEX
  BITCI
  // --- Global tier-1 (Turkiye'de de kullanilanlar dahil) ---
  BYBIT
  OKX
  COINBASE
  KRAKEN
  KUCOIN
  GATEIO
  BITGET
  HTX
  MEXC
  CRYPTOCOM
  // --- SPK lisansli yerel TR tuzel kisiler ---
  // BINANCE_TR: gercekten ayri platform (binance.tr, farkli uc noktalar) —
  // kendi adaptoru var. OKX_TR/BYBIT_TR: SPK uyumu icin kurulmus ayri
  // sirketler ama teknik olarak global OKX/Bybit ile AYNI API'yi kullanirlar
  // (ayni hesap, ayni uc nokta) — kayitta ayri secenek olarak gorunurler
  // ama arka planda ayni adaptore yonlendirilirler (bkz. adapter-registry).
  BINANCE_TR
  OKX_TR
  BYBIT_TR
}

enum ApiPermissionLevel {
  UNKNOWN     // henüz borsa üzerinden doğrulanmadı
  READ_ONLY   // doğrulandı, sadece okuma izni var
  TRADE       // işlem izni de var — istenmiyor ama tespit edildi
  WITHDRAW    // para çekme izni var — KRİTİK, kullanıcı uyarılmalı
}

enum SyncStatus {
  NEVER_SYNCED
  SYNCING
  SYNCED
  ERROR
}

model ExchangeConnection {
  id       String           @id @default(uuid())
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider ExchangeProvider
  label    String

  // AES-256-GCM ile şifreli, format: "<iv>.<authTag>.<ciphertext>" (base64).
  encryptedApiKey        String
  encryptedApiSecret     String
  encryptedPassphrase    String? // OKX gibi bazı borsalar passphrase de ister

  // Kullanıcı, borsada bu key'e SADECE read-only izin verdiğini onayladı mı?
  confirmedReadOnly   Boolean   @default(false)
  confirmedReadOnlyAt DateTime?
  // Borsa API'si üzerinden gerçekten doğrulanan izin seviyesi (bkz. adapter.getPermissionLevel).
  verifiedPermissionLevel ApiPermissionLevel @default(UNKNOWN)
  verifiedAt              DateTime?

  syncStatus   SyncStatus @default(NEVER_SYNCED)
  lastSyncedAt DateTime?
  lastSyncError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([userId])
  @@map("exchange_connections")
}

enum WalletChain {
  ETHEREUM
  BSC
  BITCOIN
}

model WalletAddress {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain        WalletChain
  address      String
  label        String?
  syncStatus   SyncStatus  @default(NEVER_SYNCED)
  lastSyncedAt DateTime?
  lastSyncError String?
  createdAt    DateTime    @default(now())

  transactions Transaction[]

  @@unique([userId, chain, address])
  @@index([userId])
  @@map("wallet_addresses")
}

enum CsvImportStatus {
  PENDING
  PROCESSED
  FAILED
}

model CsvImport {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeName  String          // API'si olmayan/desteklenmeyen platform adı (serbest metin)
  fileName      String
  rowCount      Int             @default(0)
  importedCount Int             @default(0)
  status        CsvImportStatus @default(PENDING)
  errorMessage  String?
  createdAt     DateTime        @default(now())

  transactions Transaction[]

  @@index([userId])
  @@map("csv_imports")
}

// ============================================================
// TRANSACTION AGGREGATION
// ============================================================

enum TransactionSource {
  EXCHANGE_API
  WALLET
  CSV
}

enum TransactionType {
  BUY
  SELL
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  STAKING_REWARD
  AIRDROP
  MINING_REWARD
  LP_REWARD
  FEE
  SWAP
}

// Normalize edilmiş, tek tip işlem kaydı — borsa API'si, cüzdan veya CSV
// hangi kaynaktan gelirse gelsin bu formata dönüşür (bkz. TransactionAggregationService).
model Transaction {
  id     String            @id @default(uuid())
  userId String
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  source TransactionSource

  exchangeConnectionId String?
  exchangeConnection   ExchangeConnection? @relation(fields: [exchangeConnectionId], references: [id], onDelete: SetNull)
  walletAddressId       String?
  walletAddress          WalletAddress?      @relation(fields: [walletAddressId], references: [id], onDelete: SetNull)
  csvImportId            String?
  csvImport              CsvImport?          @relation(fields: [csvImportId], references: [id], onDelete: SetNull)

  // Kaynaktaki orijinal işlem id'si — reconciliation/duplicate tespiti icin.
  externalId String?

  type           TransactionType
  asset          String   // ör. "BTC"
  quantity       Decimal  @db.Decimal(38, 18)
  priceInQuote   Decimal? @db.Decimal(38, 18)
  quoteCurrency  String?  // ör. "USDT", "TRY"
  feeAmount      Decimal? @db.Decimal(38, 18)
  feeAsset       String?
  timestamp      DateTime
  taxYear        Int

  // Kullanıcının kendi hesapları arasındaki transfer mi? true ise vergiye
  // tabi olay SAYILMAZ (bkz. TransferDetectionService — bu tespit yapılmadan
  // hatalı/şişirilmiş kâr çıkar, en öncelikli mantık burası).
  isInternalTransfer Boolean @default(false)

  // Spam/scam token filtrelemesi (bkz. SpamFilterService).
  isSpamFiltered Boolean @default(false)

  rawData Json? // orijinal payload, audit icin

  createdAt DateTime @default(now())

  taxLotsCreated  TaxLot[] @relation("AcquisitionTransaction")
  reconciliationFlags ReconciliationFlag[]

  @@unique([userId, source, externalId], name: "uniqueExternalTx")
  @@index([userId, taxYear])
  @@index([userId, asset])
  @@map("transactions")
}

enum ReconciliationFlagType {
  NEGATIVE_BALANCE
  MISSING_DATA
  DUPLICATE_SUSPECTED
}

model ReconciliationFlag {
  id            String                  @id @default(uuid())
  userId        String
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   Transaction?            @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  type          ReconciliationFlagType
  description   String
  resolved      Boolean                 @default(false)
  createdAt     DateTime                @default(now())

  @@index([userId])
  @@map("reconciliation_flags")
}

// ============================================================
// PRICE DATA
// ============================================================

enum PriceSource {
  COINGECKO
  TCMB
}

// Gunluk granulerlikte fiyat/kur cache'i — CoinGecko (coin/USD veya coin/TRY)
// ve TCMB (USD/TRY resmi kur) ayni tabloda, source alaniyla ayirt ediliyor.
model PriceCache {
  id            String      @id @default(uuid())
  asset         String      // ör. "BTC" veya "USD" (TCMB kuru için)
  quoteCurrency String      // ör. "USD", "TRY"
  date          DateTime    @db.Date
  price         Decimal     @db.Decimal(38, 18)
  source        PriceSource
  fetchedAt     DateTime    @default(now())

  @@unique([asset, quoteCurrency, date])
  @@map("price_cache")
}

// ============================================================
// TAX CALCULATION ENGINE
// ============================================================

// FIFO maliyet takibi icin "lot" — her alis islemi bir lot yaratir, satislar
// en eski lottan baslayarak tuketir (bkz. TaxCalculationService.calculateFifo).
model TaxLot {
  id                     String   @id @default(uuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset                  String
  originalQuantity       Decimal  @db.Decimal(38, 18)
  remainingQuantity      Decimal  @db.Decimal(38, 18)
  costBasisPerUnitTRY    Decimal  @db.Decimal(38, 18)
  acquisitionDate        DateTime
  acquisitionTransactionId String
  acquisitionTransaction   Transaction @relation("AcquisitionTransaction", fields: [acquisitionTransactionId], references: [id])
  taxYear                Int
  fullyConsumed           Boolean  @default(false)
  createdAt               DateTime @default(now())

  @@index([userId, asset])
  @@index([userId, taxYear])
  @@map("tax_lots")
}

// Yil bazinda hesaplanmis vergi ozeti — HER ZAMAN taslak/tahmini (isDraft
// alani UI'da acikca gosterilmeli, kesin rakam gibi sunulmamali).
model TaxYearSummary {
  id                     String   @id @default(uuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taxYear                Int

  totalRealizedGainTRY   Decimal  @db.Decimal(38, 18) @default(0)
  totalRealizedLossTRY   Decimal  @db.Decimal(38, 18) @default(0)
  netCapitalGainTRY      Decimal  @db.Decimal(38, 18) @default(0)

  // Staking/airdrop/mining — "arızi kazanç", ayrı istisna tutarına tabi.
  occasionalIncomeTRY    Decimal  @db.Decimal(38, 18) @default(0)

  capitalGainsExemptionUsedTRY Decimal @db.Decimal(38, 18) @default(0)
  occasionalIncomeExemptionUsedTRY Decimal @db.Decimal(38, 18) @default(0)
  estimatedTaxableAmountTRY    Decimal @db.Decimal(38, 18) @default(0)

  isDraft     Boolean  @default(true)
  calculatedAt DateTime @default(now())

  @@unique([userId, taxYear])
  @@map("tax_year_summaries")
}

// Yıldan yıla değişen istisna tutarları — admin tarafından yönetilir,
// hesaplama koduna hardcode edilmez.
model TaxExemptionConfig {
  id                          String   @id @default(uuid())
  taxYear                     Int      @unique
  capitalGainsExemptionTRY    Decimal  @db.Decimal(38, 18)
  occasionalIncomeExemptionTRY Decimal @db.Decimal(38, 18)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("tax_exemption_configs")
}

// ============================================================
// SPAM / SCAM TOKEN FİLTRELEME
// ============================================================

model SpamToken {
  id      String   @id @default(uuid())
  asset   String   // sembol veya contract adresi
  chain   String?
  reason  String?
  source  String   // ör. "coingecko", "manual"
  addedAt DateTime @default(now())

  @@unique([asset, chain])
  @@map("spam_tokens")
}

// ============================================================
// REPORT GENERATION
// ============================================================

enum ReportFormat {
  PDF
  EXCEL
}

model GeneratedReport {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  taxYear     Int
  format      ReportFormat
  filePath    String
  // Mali müşavir paylaşım modu — link veya e-posta ile.
  shareToken  String?      @unique
  sharedWithEmail String?
  createdAt   DateTime     @default(now())
  expiresAt   DateTime?

  @@index([userId])
  @@map("generated_reports")
}

// ============================================================
// BİLDİRİM
// ============================================================

enum NotificationType {
  DECLARATION_REMINDER
  DATA_ISSUE
  // Muhasebeciye: musterisi yeni veri ekledi / davet kabul etti / rapor tamamladi.
  ACCOUNTANT_CLIENT_ACTIVITY
  // Admin panelinden tum kullanicilara/role duyuru (bkz. AdminAnnouncementsController).
  ANNOUNCEMENT
  // Destek bileti admin tarafindan yanitlandi.
  SUPPORT_REPLY
}

model NotificationLog {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  sentAt    DateTime         @default(now())
  readAt    DateTime?

  @@index([userId])
  @@map("notification_logs")
}

// ============================================================
// ANALYTICS (site trafigi)
// ============================================================

// Anonim ziyaretci sayaci — client tarafinda localStorage'da tutulan
// rastgele bir visitorId, giris yapmis olsun olmasin her sayfa yuklemesinde
// gunde bir kere upsert edilir (bkz. AnalyticsController.track). Kisisel
// veri icermez, sadece "bugun/bu hafta/bu ay kac farkli tarayici geldi"
// sayimini mumkun kilar.
model VisitorLog {
  id        String   @id @default(uuid())
  visitorId String
  date      String // YYYY-MM-DD (UTC)
  createdAt DateTime @default(now())

  @@unique([visitorId, date])
  @@index([date])
  @@map("visitor_logs")
}

// ============================================================
// DESTEK MERKEZI
// ============================================================

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id           String        @id @default(uuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUserId String
  sender       User          @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  // Gonderen bir staff/admin mi — bilet sahibi kullaniciya göre "onlar mi
  // biz mi yazdi" ayrimini yapabilmek icin (rol degisebilir, mesaj anindaki
  // durumu donduruyor).
  isFromStaff  Boolean       @default(false)
  body         String
  createdAt    DateTime      @default(now())

  @@index([ticketId])
  @@map("support_messages")
}

// ============================================================
// PAYMENT
// ============================================================

// Plan fiyat/limitleri hardcoded DEĞİL — bu tablo üzerinden yönetilir (manage
// panelinde admin ekranı, bkz. AdminPlansController). Başlangıç verisi
// (FREE/STARTER/.../ACCOUNTANT_100) prisma/seed.ts ile yükleniyor.
model Plan {
  id               String   @id @default(uuid())
  name             String   @unique // ör. "FREE", "STARTER", "ACCOUNTANT_10"
  type             UserRole // INDIVIDUAL veya ACCOUNTANT plani
  priceTRY         Decimal  @db.Decimal(10, 2)
  // Bireysel planlar icin islem limiti (null = sinirsiz), muhasebeci
  // planlari icin musteri slotu limiti — tip'e gore sadece biri kullanilir.
  transactionLimit Int?
  clientLimit      Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]

  @@map("plans")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime
  // Yillik otomatik yenileme opsiyonel (zorunlu degil, bkz. istek).
  autoRenew Boolean            @default(false)
  createdAt DateTime           @default(now())

  payments Payment[]

  @@index([userId])
  @@map("subscriptions")
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CRYPTO
}

// Kripto odemede kullanicinin sectigi saglayici — hicbiri gercek zamanli
// otomatik tahsilat yapmiyor (API anahtarlari baglanana kadar), sadece
// kullaniciya dogru odeme talimatini (checkout linki VEYA cuzdan adresi)
// gostermek icin. Onay her zaman admin'in dekont/islem kanitini inceleyip
// markCompleted/reject cagirmasiyla olur — bkz. PaymentService yorumu.
enum CryptoProvider {
  BINANCE
  BYBIT
  OKX
}

enum CryptoAsset {
  BTC
  ETH
  USDT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REJECTED
}

model Payment {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Odeme onaylanip Subscription olusturulunca doldurulur; oncesinde hangi
  // plan icin odeme yapildigini bilmek icin planId ayrica tutuluyor.
  planId         String
  plan           Plan            @relation(fields: [planId], references: [id])
  subscriptionId String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id])
  amount         Decimal         @db.Decimal(10, 2)
  currency       String          @default("TRY")
  method         PaymentMethod
  cryptoProvider CryptoProvider?
  cryptoAsset    CryptoAsset?
  // Odeme aninda kilitlenen kur/tutar — kullanici odeme ekranini gordukten
  // sonra kur oynasa bile ne yatirmasi gerektigi degismesin diye.
  cryptoAmountLocked Decimal?    @db.Decimal(20, 8)
  cryptoRateTRY      Decimal?    @db.Decimal(20, 2)
  // Dekont (banka havalesi) veya islem kaniti (kripto) — kullanicinin
  // yukledigi dosyanin depolama anahtari, admin onay ekraninda gosterilir.
  receiptUrl     String?
  status         PaymentStatus   @default(PENDING)
  providerRef    String?
  // Mevcut donem icinde ust plana gecis mi (sadece fark odendi) yoksa yeni/
  // yenileme donemi mi baslatiyor — admin istatistiklerinde ayri gosterilir
  // (bkz. PaymentService.createPayment otomatik yukseltme tespiti ve
  // SubscriptionService.upgradeSubscription — bitis tarihini DEGISTIRMEZ).
  isUpgrade      Boolean         @default(false)
  previousPlanId String?
  createdAt      DateTime        @default(now())

  couponRedemption CouponRedemption?

  @@index([userId])
  @@map("payments")
}

// ============================================================
// MALI MUSAVIR IS ORTAKLIGI — KUPON KODLARI
// ============================================================

// Onaylanmis (accountantVerified) her musavir kendi kodunu olusturabilir
// (bkz. CouponsService.createMyCoupon). Musavir bu kodu kendi mukellefine
// verir, mukellef odeme sirasinda kullanir ve indirim alir. BILEREK bu,
// AccountantClient veri erisim izniyle ILISKILENDIRILMEZ — indirim kullanmak
// otomatik olarak musavire mukellefin borsa/vergi verisini GORME yetkisi
// VERMEZ, o ayri ve mukellefin acikca kabul ettigi davet akisidir (KVKK).
// Kupon sadece indirim + admin'in musavir basina getirdigi musteri/ciro
// istatistigini gormesi icindir.
model CouponCode {
  id               String   @id @default(uuid())
  code             String   @unique
  accountantUserId String
  accountant       User     @relation(fields: [accountantUserId], references: [id], onDelete: Cascade)
  discountPercent  Int
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  redemptions CouponRedemption[]

  @@index([accountantUserId])
  @@map("coupon_codes")
}

model CouponRedemption {
  id           String     @id @default(uuid())
  couponCodeId String
  couponCode   CouponCode @relation(fields: [couponCodeId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId    String     @unique
  payment      Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  discountTRY  Decimal    @db.Decimal(10, 2)
  createdAt    DateTime   @default(now())

  @@index([couponCodeId])
  @@map("coupon_redemptions")
}

// ============================================================
// AUDIT / SECURITY LOG
// ============================================================

// Kim, ne zaman, neyi değiştirdi/erişti — normal uygulama olayları.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // ör. "API_KEY_CREATED", "API_KEY_DELETED", "2FA_ENABLED"
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  ACCOUNT_LOCKED
  TWO_FA_FAILED
  TWO_FA_SUCCESS
  REFRESH_TOKEN_REUSE_DETECTED
  SUSPICIOUS_ACTIVITY
  EMAIL_VERIFIED
  PHONE_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
}

// Başarısız girişler, şüpheli aktivite — güvenlik odaklı, audit log'dan ayrı.
model SecurityLog {
  id        String            @id @default(uuid())
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?           // kullanıcı bulunamasa bile denenen e-posta
  eventType SecurityEventType
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([ipAddress])
  @@map("security_logs")
}

// ORCA'daki (traders.tr) SiteContentSettings ile ayni desen: tek satirlik
// singleton, admin panelden hero/footer metinlerini duzenlemek icin
// (kullanici istegi 2026-08-24: "footer hero yazılar panelden olsun").
// Her alanin varsayilan degeri, su an bilesenlerde SABIT yazili olan
// metinlerin BIREBIR ayni — hic bir kayit yoksa/duzenlenmemisse gorunum
// degismez. Sadece bu tabloya dokunur; kod deploy'u gerektirmez.
model SiteContentSettings {
  id String @id @default(cuid())

  heroBadge           String @default("Türkiye'nin ilk kripto vergi asistanı")
  heroTitlePrefix     String @default("Kripto kazancınız ile vergi arasındaki")
  heroTitleHighlight  String @default("dengeyi")
  heroTitleSuffix     String @default("biz kurarız.")
  heroDescription     String @default("KriptoBeyan ile kripto vergi hesaplama otomatikleşir: borsa hesaplarınızı ve cüzdanlarınızı bağlayın, işlemleriniz FIFO yöntemiyle hesaplansın. Kripto beyan dönemi geldiğinde taslak raporunuz hazır olsun.")
  heroPrimaryCtaLabel   String @default("Ücretsiz Başla")
  heroSecondaryCtaLabel String @default("Nasıl çalışır?")

  footerDescription   String  @default("Türkiye'nin kripto varlık vergi beyan asistanı.")
  footerCopyrightText String? // bos ise bilesen "© {yil} KriptoBeyan. Tüm hakları saklıdır." hesaplar
  footerSupportEmail  String? // bos ise SUPPORT_EMAIL sabiti kullanilir

  updatedAt DateTime @updatedAt

  @@map("site_content_settings")
}
